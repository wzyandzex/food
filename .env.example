# ==== Supabase（免费档，M1 接入；在 https://supabase.com 创建项目后填入）====
# 项目设置 → API 中的三个值
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用，绝不暴露给客户端；M0 阶段管理端导入管线会用到
SUPABASE_SERVICE_ROLE_KEY=

# ==== 管理端 ====
# 管理端登录密码（M0 占位认证；M1 换 Supabase Auth）
ADMIN_PASSWORD=change-me

# ==== PWA Web Push（M2 通知中心）====
# VAPID 公私钥对（用于签名 Web Push 推送，零成本无需任何第三方账户）
# ⚠️ 私钥属机密：只配在服务端环境变量，严禁提交任何真实值进仓库
# 运行 `node scripts/generate-vapid-keys.mjs` 可生成一对新密钥
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kaifan-notifications@example.com

# ==== 定时任务（截单提醒 cron，见 .github/workflows/deadline-reminders.yml）====
# 自定义随机长字符串即可；GitHub Actions Secrets 与部署环境需配置相同值
CRON_SECRET=

# ==== LLM 导入管线（管理端：URL 抽取 / OCR 图片识别 / 菜名批量生成）====
# OpenAI 兼容协议；默认指向智谱开放平台（glm-4-flash 与 glm-4v-flash 均为免费模型，零成本）
LLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 在 https://open.bigmodel.cn 注册后创建的 API Key
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_VISION_MODEL=glm-4v-flash
